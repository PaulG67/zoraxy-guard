<?xml version="1.0"?>
<Container version="2">
  <Name>zoraxy-guard</Name>
  <Repository>ghcr.io/paulg67/zoraxy-guard:latest</Repository>
  <Registry>https://github.com/users/PaulG67/packages/container/package/zoraxy-guard</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/PaulG67/zoraxy-guard/issues</Support>
  <Project>https://github.com/PaulG67/zoraxy-guard</Project>
  <Overview>
Zoraxy Guard – Security-Monitor für Zoraxy-Logs. Erkennt Exploit-Scans, Threat-Listen und Zugriffe mit Handlungsbedarf. Web-GUI auf Port 8787 (Status, History, CrowdSec, Geprüft, Konfiguration). Alarme: Pushover, Discord, Telegram. Standard: nur Handlungsbedarf, keine 403-Scanner.&#13;
&#13;
CrowdSec YAML in der GUI: Pfade «CrowdSec Config» (/etc/crowdsec) und «CrowdSec Bouncer» (Plugin-Ordner mit config.yaml). Host-Pfade prüfen, dann Apply.&#13;
&#13;
SETUP / Vorlage aktualisieren (Unraid-Terminal):&#13;
bash &lt;(curl -fsSL https://raw.githubusercontent.com/PaulG67/zoraxy-guard/main/unraid/install-template.sh)&#13;
Danach bestehenden Container: Docker → zoraxy-guard → Edit → CrowdSec-Pfade prüfen → Apply.&#13;
Image-only: Docker → Force Update. Neue Volumes kommen nur mit Edit → Apply.
  </Overview>
  <Category>Security: Network:Other Tools: Productivity:</Category>
  <WebUI>http://[IP]:[PORT:8787]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/PaulG67/zoraxy-guard/main/unraid/my-zoraxy-guard.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/PaulG67/zoraxy-guard/main/unraid/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText></DonateText>
  <DonateLink></DonateLink>
  <Requires>install-template.sh (Vorlage). Neue Pfade: Script, dann Container Edit → Apply.</Requires>

  <Config Name="WebUI" Target="8787" Default="8787" Mode="tcp" Description="Web-Oberfläche" Type="Port" Display="always" Required="true" Mask="false">8787</Config>

  <Config Name="Zoraxy Logs" Target="/logs" Default="/mnt/user/appdata/zoraxy/log" Mode="ro" Description="Zoraxy Log-Ordner mit zr_*.log (read-only)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/zoraxy/log</Config>
  <Config Name="Config File" Target="/config/config.yaml" Default="/mnt/user/appdata/zoraxy-guard/config.yaml" Mode="rw" Description="config.yaml (schreibbar für GUI)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/zoraxy-guard/config.yaml</Config>
  <Config Name="Appdata Data" Target="/data" Default="/mnt/user/appdata/zoraxy-guard/data" Mode="rw" Description="State, Listen, Feed-Cache" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/zoraxy-guard/data</Config>

  <Config Name="CrowdSec Config" Target="/crowdsec-config" Default="/mnt/user/appdata/crowdsec" Mode="rw" Description="CrowdSec /etc/crowdsec (oft /mnt/user/appdata/crowdsec oder .../crowdsec/config). Für Reiter CrowdSec → YAML / Listen." Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/crowdsec</Config>
  <Config Name="CrowdSec Bouncer" Target="/crowdsec-bouncer" Default="/mnt/user/appdata/zoraxy/plugin/zoraxy_crowdsec_bouncer" Mode="rw" Description="Zoraxy CrowdSec-Plugin-Ordner mit config.yaml (nicht die Datei allein). Alternativ .../plugins/zoraxy_crowdsec_bouncer" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/zoraxy/plugin/zoraxy_crowdsec_bouncer</Config>

  <Config Name="Timezone" Target="TZ" Default="Europe/Zurich" Mode="rw" Description="Zeitzone" Type="Variable" Display="always" Required="false" Mask="false">Europe/Zurich</Config>
  <Config Name="Config Path (internal)" Target="ZORAXY_GUARD_CONFIG" Default="/config/config.yaml" Mode="rw" Description="Pfad zur Config im Container" Type="Variable" Display="advanced" Required="false" Mask="false">/config/config.yaml</Config>
  <Config Name="Web UI enabled" Target="WEB_ENABLED" Default="true" Mode="rw" Description="true/false" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Web Port (container)" Target="WEB_PORT" Default="8787" Mode="rw" Description="Port im Container" Type="Variable" Display="advanced" Required="false" Mask="false">8787</Config>
  <Config Name="Web Password" Target="WEB_PASSWORD" Default="" Mode="rw" Description="Passwort für Web-GUI (leer = kein Login)" Type="Variable" Display="always" Required="false" Mask="true"></Config>

  <Config Name="CrowdSec Config Dir (internal)" Target="CROWDSEC_CONFIG_DIR" Default="/crowdsec-config" Mode="rw" Description="Pfad zu CrowdSec /etc/crowdsec IM Guard-Container (zum Volume CrowdSec Config passend)" Type="Variable" Display="advanced" Required="false" Mask="false">/crowdsec-config</Config>
  <Config Name="CrowdSec Bouncer YAML (internal)" Target="CROWDSEC_BOUNCER_CONFIG" Default="/crowdsec-bouncer/config.yaml" Mode="rw" Description="Pfad zur Bouncer-config.yaml IM Guard-Container" Type="Variable" Display="advanced" Required="false" Mask="false">/crowdsec-bouncer/config.yaml</Config>

  <Config Name="Discord Webhook" Target="DISCORD_WEBHOOK" Default="" Mode="rw" Description="Optional" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Telegram Bot Token" Target="TELEGRAM_BOT_TOKEN" Default="" Mode="rw" Description="Optional" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Telegram Chat ID" Target="TELEGRAM_CHAT_ID" Default="" Mode="rw" Description="Optional" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Pushover User Key" Target="PUSHOVER_USER_KEY" Default="" Mode="rw" Description="https://pushover.net" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Pushover API Token" Target="PUSHOVER_API_TOKEN" Default="" Mode="rw" Description="Pushover App API Token" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Pushover Device" Target="PUSHOVER_DEVICE" Default="" Mode="rw" Description="Optional Gerätename" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Pushover Sound" Target="PUSHOVER_SOUND" Default="" Mode="rw" Description="Optional z.B. pushover, siren" Type="Variable" Display="always" Required="false" Mask="false"></Config>

  <Config Name="Known Lists" Target="KNOWN_LISTS" Default="ipsum-level5,blocklist-de-apache,blocklist-de-bruteforce,feodo-ip" Mode="rw" Description="Komma-getrennte Threat-Listen" Type="Variable" Display="always" Required="false" Mask="false">ipsum-level5,blocklist-de-apache,blocklist-de-bruteforce,feodo-ip</Config>
  <Config Name="Allowlist IPs" Target="ALLOWLIST_IPS" Default="192.168.0.0/16,10.0.0.0/8" Mode="rw" Description="Vertrauenswürdige CIDRs" Type="Variable" Display="always" Required="false" Mask="false">192.168.0.0/16,10.0.0.0/8</Config>
  <Config Name="Min Severity" Target="MIN_SEVERITY" Default="medium" Mode="rw" Description="info|low|medium|high|critical" Type="Variable" Display="always" Required="false" Mask="false">medium</Config>
</Container>
