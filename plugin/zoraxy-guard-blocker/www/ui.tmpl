{{define "layout"}}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Zoraxy proxies this UI under /plugin.ui/<plugin-id>/ui/, so every link and
     form action below must stay relative to this base. -->
<base href="./">
<meta name="zoraxy-csrf" content="{{.CSRFToken}}">
<title>{{.Title}} · Zoraxy Guard Blocker</title>
<style>
  :root { --bg:#0f1420; --panel:#161d2d; --border:#28324a; --text:#e7ecf5; --muted:#8f9bb3; --accent:#5ec2a4; --warn:#f0b429; --err:#f07178; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--text); font:14px/1.45 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; }
  a { color: var(--accent); text-decoration:none; }
  a:hover { text-decoration: underline; }
  .wrap { max-width:1080px; margin:0 auto; padding:18px 20px 60px; }
  header.bar { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; flex-wrap:wrap; gap:10px; }
  header.bar h1 { font-size:1.1rem; margin:0; }
  nav a { margin-right:14px; padding:6px 10px; border-radius:8px; }
  nav a.active { background:var(--panel); border:1px solid var(--border); }
  .card { background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:16px 18px; margin-bottom:16px; }
  .hint { color:var(--muted); font-size:0.85rem; }
  table { width:100%; border-collapse:collapse; font-size:0.86rem; }
  th, td { text-align:left; padding:7px 8px; border-bottom:1px solid var(--border); vertical-align:top; }
  th { color:var(--muted); font-weight:600; text-transform:uppercase; font-size:0.72rem; letter-spacing:0.03em; }
  code, .mono { font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
  .chip { display:inline-block; background:#20293d; border:1px solid var(--border); border-radius:999px; padding:2px 9px; margin:1px 3px 1px 0; font-size:0.78rem; }
  .chip.tag { color:var(--accent); border-color:rgba(94,194,164,0.4); }
  label { display:block; font-size:0.82rem; color:var(--muted); margin:10px 0 4px; }
  input[type=text], input[type=number], select, textarea { width:100%; background:#0e131e; border:1px solid var(--border); border-radius:7px; color:var(--text); padding:8px 9px; font:inherit; }
  input[type=checkbox] { margin-right:6px; }
  button, .btn { appearance:none; border:1px solid var(--border); background:#243145; color:var(--text); border-radius:8px; padding:8px 14px; font:inherit; cursor:pointer; }
  button.primary { background:var(--accent); border-color:transparent; color:#04150f; font-weight:600; }
  button.danger { background:rgba(240,113,120,0.16); border-color:rgba(240,113,120,0.4); }
  button:hover { filter:brightness(1.08); }
  .row { display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; }
  .row > div { flex:1; min-width:160px; }
  .flash { padding:9px 12px; border-radius:8px; margin-bottom:14px; font-size:0.86rem; }
  .flash.ok { background:rgba(94,194,164,0.15); border:1px solid rgba(94,194,164,0.4); }
  .flash.error { background:rgba(240,113,120,0.15); border:1px solid rgba(240,113,120,0.4); }
  .muted { color:var(--muted); }
  .badge-off { color:var(--muted); }
  .setup-box { border-left:3px solid var(--warn); padding-left:12px; }
  select.tag-pick { margin-top:6px; font-size:0.82rem; color:var(--muted); }
  .foot { margin-top:24px; padding-top:12px; border-top:1px solid var(--border); display:flex; align-items:center; gap:12px; flex-wrap:wrap; font-size:0.82rem; }
  .foot pre { flex-basis:100%; margin:0; background:#0e131e; border:1px solid var(--border); border-radius:7px; padding:10px 12px; overflow:auto; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:0.78rem; white-space:pre-wrap; }
  .win-tabs { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
  .win-tabs a { padding:6px 12px; border-radius:8px; border:1px solid var(--border); color:var(--muted); }
  .win-tabs a.active { background:var(--accent); border-color:transparent; color:#04150f; font-weight:600; text-decoration:none; }
  .hit-chart { width:100%; height:auto; display:block; }
  .chart-grid { stroke:var(--border); stroke-width:1; }
  .chart-axis { fill:var(--muted); font-size:11px; font-family:inherit; }
  .chart-bar { fill:var(--accent); opacity:0.9; }
  .chart-bar:hover { opacity:1; filter:brightness(1.1); }
  .stat-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; }
  .stat-big { font-size:2rem; font-weight:700; color:var(--accent); margin:4px 0 0; }
  .rank-bar { display:flex; align-items:center; gap:8px; margin:5px 0; font-size:0.84rem; }
  .rank-bar .name { flex:0 1 45%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .rank-bar .track { flex:1; height:8px; background:#0e131e; border-radius:999px; overflow:hidden; }
  .rank-bar .fill { height:100%; background:var(--accent); border-radius:999px; }
  .rank-bar .n { flex:0 0 auto; color:var(--muted); font-variant-numeric:tabular-nums; min-width:2.5em; text-align:right; }
</style>
</head>
<body>
<div class="wrap">
  <header class="bar">
    <h1>🛡 Zoraxy Guard Blocker</h1>
    <nav>
      <a href="." class="{{if eq .Active "dashboard"}}active{{end}}">Übersicht</a>
      <a href="rules" class="{{if eq .Active "rules"}}active{{end}}">Pfad-Regeln</a>
      <a href="domains" class="{{if eq .Active "domains"}}active{{end}}">Domains</a>
      <a href="stats" class="{{if eq .Active "stats"}}active{{end}}">Statistik</a>
      <a href="import" class="{{if eq .Active "import"}}active{{end}}">Import</a>
    </nav>
  </header>
  {{if .Flash}}<div class="flash {{.FlashKind}}">{{.Flash}}</div>{{end}}
  {{.Content}}
  <footer class="foot">
    <span class="muted">Plugin-Build {{.Revision}}</span>
    <button type="button" id="diag-run">Diagnose</button>
    <pre id="diag-out" hidden></pre>
  </footer>
</div>
<script>
(function () {
  var meta = document.querySelector('meta[name="zoraxy-csrf"]');
  var csrfToken = meta ? meta.getAttribute('content') : '';

  function showError(msg) {
    var box = document.createElement('div');
    box.className = 'flash error';
    box.textContent = msg;
    var wrap = document.querySelector('.wrap');
    wrap.insertBefore(box, wrap.children[1]);
    box.scrollIntoView({ block: 'nearest' });
    var out = document.getElementById('diag-out');
    if (out) {
      out.hidden = false;
      out.textContent = msg;
    }
  }

  function goAfterSave(target, flash, kind) {
    var dest = target || '.';
    if (flash) {
      dest += (dest.indexOf('?') >= 0 ? '&' : '?') +
        'flash=' + encodeURIComponent(flash) +
        '&flash_kind=' + encodeURIComponent(kind || 'ok');
    }
    // location.assign ignores <base>; resolve against the current page URL.
    window.location.assign(new URL(dest, window.location.href).href);
  }

  function postForm(form) {
    var data = new FormData(form);
    var hasUpload = false;
    data.forEach(function (value) {
      if (value instanceof File && value.name !== '') hasUpload = true;
    });
    var target = form.getAttribute('action') || form.action || '.';
    var out = document.getElementById('diag-out');
    if (out) {
      out.hidden = false;
      out.textContent = 'Speichere → ' + target + ' …';
    }

    return fetch(target, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'X-CSRF-Token': csrfToken,
        'Accept': 'application/json',
        'X-Requested-With': 'fetch'
      },
      body: hasUpload ? data : new URLSearchParams(data)
    }).then(function (res) {
      return res.text().then(function (text) {
        if (out) {
          out.textContent =
            'HTTP ' + res.status + ' → ' + target + '\n' +
            text.slice(0, 1500);
        }
        if (!res.ok) {
          throw new Error('HTTP ' + res.status + ' — ' + text.slice(0, 300));
        }
        var trimmed = (text || '').replace(/^\s+/, '');
        if (trimmed.charAt(0) === '{') {
          try {
            var j = JSON.parse(text);
            goAfterSave(j.redirect || target, j.flash || '', j.flash_kind || 'ok');
            return;
          } catch (e) { /* fall through to HTML */ }
        }
        document.open('text/html', 'replace');
        document.write(text);
        document.close();
      });
    });
  }

  // Zoraxy embeds plugin UIs in <iframe sandbox="allow-scripts allow-same-origin">
  // WITHOUT allow-forms and WITHOUT allow-modals. Native form submit is blocked,
  // and window.confirm()/alert() are also blocked — delete buttons that waited
  // on confirm appeared to do nothing. Confirmation is a second click instead.
  document.addEventListener('click', function (ev) {
    var btn = ev.target && ev.target.closest
      ? ev.target.closest('button[data-post], button.primary, button.danger, button[type="submit"]')
      : null;
    if (!btn || btn.id === 'diag-run') return;
    var form = btn.closest('form');
    if (!form) return;
    if ((form.method || 'get').toLowerCase() !== 'post') return;
    ev.preventDefault();
    ev.stopPropagation();

    var needConfirm = btn.getAttribute('data-confirm');
    if (needConfirm && btn.getAttribute('data-armed') !== '1') {
      document.querySelectorAll('button[data-armed="1"]').forEach(function (other) {
        if (other === btn) return;
        other.setAttribute('data-armed', '0');
        if (other.getAttribute('data-label-orig')) {
          other.textContent = other.getAttribute('data-label-orig');
        }
      });
      btn.setAttribute('data-label-orig', btn.textContent);
      btn.setAttribute('data-armed', '1');
      btn.textContent = 'Nochmals klicken: ' + needConfirm;
      setTimeout(function () {
        if (btn.getAttribute('data-armed') !== '1') return;
        btn.setAttribute('data-armed', '0');
        btn.textContent = btn.getAttribute('data-label-orig') || btn.textContent;
      }, 4000);
      return;
    }
    if (needConfirm) {
      btn.setAttribute('data-armed', '0');
      if (btn.getAttribute('data-label-orig')) {
        btn.textContent = btn.getAttribute('data-label-orig');
      }
    }

    postForm(form).catch(function (err) {
      showError('Speichern fehlgeschlagen: ' + err.message);
    });
  }, true);

  // Also swallow any submit that slips through (e.g. Enter in an input).
  document.addEventListener('submit', function (ev) {
    var form = ev.target;
    if (!form || form.tagName !== 'FORM') return;
    if ((form.method || 'get').toLowerCase() !== 'post') return;
    ev.preventDefault();
    postForm(form).catch(function (err) {
      showError('Speichern fehlgeschlagen: ' + err.message);
    });
  }, true);

  var diagBtn = document.getElementById('diag-run');
  if (diagBtn) diagBtn.addEventListener('click', function () {
    var out = document.getElementById('diag-out');
    out.hidden = false;
    out.textContent = 'läuft…';
    var probe = new URLSearchParams({
      action: 'add',
      path: '/.zgb-selftest',
      match_type: 'exact',
      tag: 'selftest',
      note: 'Diagnose-Probe'
    });
    Promise.all([
      fetch('selftest', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'X-CSRF-Token': csrfToken },
        body: new URLSearchParams({ probe: 'hallo-welt' })
      }).then(function (r) { return r.text().then(function (t) { return { status: r.status, url: r.url, text: t }; }); }),
      fetch('rules', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'X-CSRF-Token': csrfToken,
          'Accept': 'application/json',
          'X-Requested-With': 'fetch'
        },
        body: probe
      }).then(function (r) { return r.text().then(function (t) { return { status: r.status, url: r.url, text: t }; }); })
    ]).then(function (pair) {
      var st = pair[0], add = pair[1];
      out.textContent =
        'Token im Browser: ' + (csrfToken ? csrfToken.length + ' Zeichen' : 'FEHLT') + '\n\n' +
        '--- selftest HTTP ' + st.status + ' ---\n' + st.text.slice(0, 2000) + '\n\n' +
        '--- rules add HTTP ' + add.status + ' ---\n' +
        'Ziel: ' + add.url + '\n' +
        add.text.slice(0, 2000);
    }).catch(function (err) {
      out.textContent = 'Verbindung fehlgeschlagen: ' + err.message;
    });
  });

  // Dropdowns marked .tag-pick copy an existing tag into their text field so
  // tags stay consistent without having to retype them.
  document.addEventListener('change', function (ev) {
    var picker = ev.target;
    if (!picker.classList || !picker.classList.contains('tag-pick')) return;
    var input = document.getElementById(picker.getAttribute('data-target'));
    if (!input || !picker.value) return;
    if (picker.getAttribute('data-append') === '1') {
      var current = input.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
      if (current.indexOf(picker.value) === -1) current.push(picker.value);
      input.value = current.join(', ');
    } else {
      input.value = picker.value;
    }
    picker.value = '';
    input.focus();
  });
})();
</script>
</body>
</html>
{{end}}

{{define "dashboard"}}
<div class="card setup-box">
  <h3 style="margin-top:0;">Einrichtung in Zoraxy (einmalig pro Domain)</h3>
  <p class="hint">
    Damit Zoraxy überhaupt Traffic an dieses Plugin schickt, muss die Domain in
    <strong>HTTP Proxy Rules → Domain bearbeiten → Tags</strong> den Tag
    <code>{{.EnableTag}}</code> erhalten, und dieses Plugin muss unter
    <strong>Plugins</strong> für den Tag <code>{{.EnableTag}}</code> aktiviert sein.
    Welche Pfade dann für diese Domain wirklich gesperrt werden, steuerst du danach
    <em>hier</em> im Plugin über die eigenen Tags (Reiter «Domains» und «Pfad-Regeln»).
  </p>
</div>

<div class="card">
  <h3 style="margin-top:0;">Tags im Überblick</h3>
  {{if not .Tags}}
    <p class="muted">Noch keine Tags angelegt. Lege unter «Pfad-Regeln» oder «Domains» einen Tag an.</p>
  {{else}}
  <table>
    <thead><tr><th>Tag</th><th>Domains</th><th>Aktive Pfad-Regeln</th></tr></thead>
    <tbody>
      {{range .TagSummaries}}
      <tr>
        <td><span class="chip tag">{{.Name}}</span></td>
        <td>{{.DomainCount}}</td>
        <td>{{.RuleCount}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{end}}
</div>

<div class="card">
  <h3 style="margin-top:0;">Zuletzt gesperrt</h3>
  {{if not .RecentHits}}
    <p class="muted">Noch keine Zugriffe geblockt.</p>
  {{else}}
  <table>
    <thead><tr><th>Pfad</th><th>Tag</th><th>Treffer</th><th>Zuletzt</th></tr></thead>
    <tbody>
      {{range .RecentHits}}
      <tr><td class="mono">{{.Path}}</td><td><span class="chip tag">{{.Tag}}</span></td><td>{{.Hits}}</td><td>{{.LastHit}}</td></tr>
      {{end}}
    </tbody>
  </table>
  {{end}}
</div>
{{end}}

{{define "rules"}}
<div class="card">
  <h3 style="margin-top:0;">Neue Pfad-Regel (manueller Eintrag)</h3>
  <form method="post" action="rules">
    <input type="hidden" name="action" value="add">
    <div class="row">
      <div>
        <label>Pfad</label>
        <input type="text" name="path" placeholder="/.envrc" required>
      </div>
      <div>
        <label>Match-Typ</label>
        <select name="match_type">
          <option value="exact">exakt</option>
          <option value="prefix">Prefix (inkl. Unterpfade)</option>
          <option value="wildcard">Wildcard (z. B. /.git/*)</option>
        </select>
      </div>
      <div>
        <label>Tag</label>
        <input type="text" name="tag" id="rule-tag" list="known-tags" placeholder="dotfiles" required>
        {{if .Tags}}
        <select class="tag-pick" data-target="rule-tag">
          <option value="">— bestehenden Tag übernehmen —</option>
          {{range .Tags}}<option value="{{.Name}}">{{.Name}}</option>{{end}}
        </select>
        {{end}}
      </div>
      <div>
        <label>Notiz (optional)</label>
        <input type="text" name="note" placeholder="gefunden auf files.gehring.li">
      </div>
      <div style="flex:0;">
        <label>&nbsp;</label>
        <button class="primary" type="button" data-post>Hinzufügen</button>
      </div>
    </div>
  </form>
  <datalist id="known-tags">{{range .Tags}}<option value="{{.Name}}">{{end}}</datalist>
</div>

<div class="card">
  <h3 style="margin-top:0;">Bestehende Pfad-Regeln ({{len .Rules}})</h3>
  {{if not .Rules}}
    <p class="muted">Noch keine Regeln. Lege oben eine an oder importiere Einträge aus Zoraxy Guard.</p>
  {{else}}
  <table>
    <thead><tr><th>Pfad</th><th>Match</th><th>Tag</th><th>Aktiv</th><th>Treffer</th><th>Notiz</th><th></th></tr></thead>
    <tbody>
      {{range .Rules}}
      <tr>
        <td class="mono">{{.Path}}</td>
        <td>{{.MatchType}}</td>
        <td><span class="chip tag">{{.Tag}}</span></td>
        <td>
          <form method="post" action="rules" style="display:inline;">
            <input type="hidden" name="action" value="toggle">
            <input type="hidden" name="id" value="{{.ID}}">
            <button type="button" data-post>{{if .Enabled}}aktiv – deaktivieren{{else}}inaktiv – aktivieren{{end}}</button>
          </form>
        </td>
        <td>{{.Hits}}</td>
        <td class="muted">{{.Note}}</td>
        <td>
          <form method="post" action="rules" style="display:inline;">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="id" value="{{.ID}}">
            <button type="button" class="danger" data-post data-confirm="Regel löschen?">Löschen</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{end}}
</div>
{{end}}

{{define "domains"}}
<div class="card">
  <h3 style="margin-top:0;">Domain einem oder mehreren Tags zuweisen</h3>
  <p class="hint">Nur Domains, die hier eingetragen sind, werden von diesem Plugin überhaupt geprüft (unabhängig vom Zoraxy-Tag, siehe Übersicht).</p>
  <form method="post" action="domains">
    <input type="hidden" name="action" value="set">
    <div class="row">
      <div>
        <label>Domain</label>
        <input type="text" name="domain" id="domain-input" list="proxy-hosts" placeholder="files.gehring.li" required>
        {{if .ProxyHosts}}
        <select class="tag-pick" data-target="domain-input">
          <option value="">— Domain aus Zoraxy wählen —</option>
          {{range .ProxyHosts}}<option value="{{.}}">{{.}}</option>{{end}}
        </select>
        {{else if .ProxyHostsErr}}
        <p class="hint" style="margin:6px 0 0; color:var(--err);">Zoraxy-Domainliste nicht geladen: {{.ProxyHostsErr}}</p>
        {{else}}
        <p class="hint" style="margin:6px 0 0;">Keine HTTP-Proxy-Domains von Zoraxy gemeldet — Domain manuell eintragen.</p>
        {{end}}
      </div>
      <div>
        <label>Tags (Komma-getrennt)</label>
        <input type="text" name="tags" id="domain-tags" list="known-tags" placeholder="dotfiles, secrets" required>
        {{if .Tags}}
        <select class="tag-pick" data-target="domain-tags" data-append="1">
          <option value="">— bestehenden Tag hinzufügen —</option>
          {{range .Tags}}<option value="{{.Name}}">{{.Name}}</option>{{end}}
        </select>
        {{end}}
      </div>
      <div style="flex:0;">
        <label>&nbsp;</label>
        <button class="primary" type="button" data-post>Speichern</button>
      </div>
    </div>
  </form>
  <datalist id="known-tags">{{range .Tags}}<option value="{{.Name}}">{{end}}</datalist>
  <datalist id="proxy-hosts">{{range .ProxyHosts}}<option value="{{.}}">{{end}}</datalist>
</div>

<div class="card">
  <h3 style="margin-top:0;">Zugewiesene Domains ({{len .Domains}})</h3>
  {{if not .Domains}}
    <p class="muted">Noch keine Domain zugewiesen.</p>
  {{else}}
  <table>
    <thead><tr><th>Domain</th><th>Tags</th><th></th></tr></thead>
    <tbody>
      {{range .Domains}}
      <tr>
        <td class="mono">{{.Domain}}</td>
        <td>{{range .Tags}}<span class="chip tag">{{.}}</span>{{end}}</td>
        <td>
          <form method="post" action="domains" style="display:inline;">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="domain" value="{{.Domain}}">
            <button type="button" class="danger" data-post data-confirm="Domain-Zuweisung löschen?">Löschen</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{end}}
</div>
{{end}}

{{define "stats"}}
<div class="card">
  <h3 style="margin-top:0;">Blockierte Anfragen</h3>
  <p class="hint">Nur Treffer seit dem Update mit Hit-Protokoll (ältere Gesamttreffer in den Pfad-Regeln zählen hier nicht rückwirkend). Aufzeichnung max. 14 Tage / 20 000 Events.</p>
  <div class="win-tabs">
    <a href="stats?w=24h" class="{{if eq .Window "24h"}}active{{end}}">24 Stunden</a>
    <a href="stats?w=7d" class="{{if eq .Window "7d"}}active{{end}}">7 Tage</a>
    <a href="stats?w=14d" class="{{if eq .Window "14d"}}active{{end}}">14 Tage</a>
  </div>
  <div class="stat-big">{{.Total}}</div>
  <div class="hint" style="margin-bottom:12px;">
    {{if eq .Window "24h"}}Blockierungen in den letzten 24 Stunden (pro Stunde){{end}}
    {{if eq .Window "7d"}}Blockierungen in den letzten 7 Tagen (pro Tag){{end}}
    {{if eq .Window "14d"}}Blockierungen in den letzten 14 Tagen (pro Tag){{end}}
  </div>
  {{.Chart}}
</div>

<div class="stat-grid">
  <div class="card">
    <h3 style="margin-top:0;">Top-Pfade</h3>
    {{if not .TopPaths}}
      <p class="muted">Noch keine Treffer im Zeitraum.</p>
    {{else}}
      {{range .TopPaths}}
      <div class="rank-bar" title="{{.Name}}">
        <span class="name mono">{{.Name}}</span>
        <span class="track"><span class="fill" style="width:{{.Pct}}%"></span></span>
        <span class="n">{{.Count}}</span>
      </div>
      {{end}}
    {{end}}
  </div>
  <div class="card">
    <h3 style="margin-top:0;">Top-Tags</h3>
    {{if not .TopTags}}
      <p class="muted">—</p>
    {{else}}
      {{range .TopTags}}
      <div class="rank-bar">
        <span class="name"><span class="chip tag">{{.Name}}</span></span>
        <span class="track"><span class="fill" style="width:{{.Pct}}%"></span></span>
        <span class="n">{{.Count}}</span>
      </div>
      {{end}}
    {{end}}
  </div>
  <div class="card">
    <h3 style="margin-top:0;">Top-Domains</h3>
    {{if not .TopDomains}}
      <p class="muted">—</p>
    {{else}}
      {{range .TopDomains}}
      <div class="rank-bar" title="{{.Name}}">
        <span class="name mono">{{.Name}}</span>
        <span class="track"><span class="fill" style="width:{{.Pct}}%"></span></span>
        <span class="n">{{.Count}}</span>
      </div>
      {{end}}
    {{end}}
  </div>
</div>
{{end}}

{{define "import_form"}}
<div class="card">
  <h3 style="margin-top:0;">Aus Zoraxy Guard exportierte Einträge importieren</h3>
  <p class="hint">
    In Zoraxy Guard: History → Handlungsbedarf-Zeilen ankreuzen → «Ausgewählte für Sperr-Plugin exportieren».
    Die heruntergeladene JSON-Datei hier einfügen oder hochladen. Im nächsten Schritt wählst du pro Zeile
    (oder für alle zusammen) einen Tag und den Match-Typ — Regeln und Domain-Zuweisung werden erst danach angelegt.
  </p>
  <form method="post" action="import" enctype="multipart/form-data">
    <input type="hidden" name="step" value="preview">
    <label>JSON-Datei</label>
    <input type="file" name="file" accept="application/json">
    <label>… oder JSON einfügen</label>
    <textarea name="raw_json" rows="8" placeholder='{"entries": [...] }'></textarea>
    <div style="margin-top:12px;">
      <button class="primary" type="button" data-post>Weiter zur Tag-Auswahl</button>
    </div>
  </form>
</div>
{{end}}

{{define "import_preview"}}
<div class="card">
  <h3 style="margin-top:0;">Tags zuweisen und übernehmen ({{len .Rows}} Einträge)</h3>
  {{if .SkippedCount}}<p class="hint">{{.SkippedCount}} Einträge übersprungen (ungültig/leer).</p>{{end}}
  <form method="post" action="import">
    <input type="hidden" name="step" value="apply">
    <div class="row" style="margin-bottom:6px;">
      <div>
        <label>Tag für alle markierten Zeilen setzen</label>
        <input type="text" id="bulk-tag" list="known-tags" placeholder="dotfiles">
        {{if .Tags}}
        <select class="tag-pick" data-target="bulk-tag">
          <option value="">— bestehenden Tag übernehmen —</option>
          {{range .Tags}}<option value="{{.Name}}">{{.Name}}</option>{{end}}
        </select>
        {{end}}
      </div>
      <div>
        <label>Match-Typ für alle markierten Zeilen setzen</label>
        <select id="bulk-match">
          <option value="">— unverändert —</option>
          <option value="exact">exakt</option>
          <option value="prefix">Prefix</option>
          <option value="wildcard">Wildcard</option>
        </select>
      </div>
      <div style="flex:0;">
        <label>&nbsp;</label>
        <button type="button" onclick="applyBulk()">Auf Auswahl anwenden</button>
      </div>
    </div>
    <datalist id="known-tags">{{range .Tags}}<option value="{{.Name}}">{{end}}</datalist>
    <table>
      <thead><tr><th><input type="checkbox" id="chk-all" onclick="toggleAll(this)"></th><th>Domain</th><th>Pfad</th><th>Status</th><th>Notiz</th><th>Tag</th><th>Match-Typ</th></tr></thead>
      <tbody>
        {{range $i, $row := .Rows}}
        <tr>
          <td><input type="checkbox" class="row-chk"></td>
          <td class="mono">{{$row.Domain}}
            <input type="hidden" name="domain" value="{{$row.Domain}}">
          </td>
          <td class="mono">{{$row.Path}}
            <input type="hidden" name="path" value="{{$row.Path}}">
          </td>
          <td>{{$row.Status}}</td>
          <td class="muted">{{$row.Note}}</td>
          <td><input type="text" name="tag" class="row-tag" list="known-tags" value="{{$row.SuggestedTag}}" required></td>
          <td>
            <select name="match_type" class="row-match">
              <option value="exact" {{if eq $row.SuggestedMatch "exact"}}selected{{end}}>exakt</option>
              <option value="prefix" {{if eq $row.SuggestedMatch "prefix"}}selected{{end}}>Prefix</option>
              <option value="wildcard" {{if eq $row.SuggestedMatch "wildcard"}}selected{{end}}>Wildcard</option>
            </select>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
    <div style="margin-top:14px;">
      <button class="primary" type="button" data-post>Regeln übernehmen &amp; Domains taggen</button>
      <a href="import" class="btn" style="margin-left:8px;">Abbrechen</a>
    </div>
  </form>
</div>
<script>
function toggleAll(src) { document.querySelectorAll('.row-chk').forEach(function(c){ c.checked = src.checked; }); }
function applyBulk() {
  var tag = document.getElementById('bulk-tag').value.trim();
  var match = document.getElementById('bulk-match').value;
  document.querySelectorAll('tr').forEach(function(tr){
    var chk = tr.querySelector('.row-chk');
    if (!chk || !chk.checked) return;
    if (tag) { var t = tr.querySelector('.row-tag'); if (t) t.value = tag; }
    if (match) { var m = tr.querySelector('.row-match'); if (m) m.value = match; }
  });
}
</script>
{{end}}
